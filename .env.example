# ============================================================================
# OpenMonitor - environment configuration
# Copy this file to .env and adjust the values before running
# `docker compose up -d`.
# ============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=openmonitor
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=openmonitor

# --- Auth --------------------------------------------------------------------
# REQUIRED. Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
API_TOKEN_PREFIX=om_

# --- Bootstrap admin (created once by the `migrate` service, if unset no
#     admin is created and the first person to register becomes admin) ------
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Networking / CORS --------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app; used to build links in notifications.
PUBLIC_BASE_URL=http://localhost:3000

# --- Ports exposed on the host ------------------------------------------------
API_PORT=3001
WEB_PORT=3000

# --- Feature flags / policy ----------------------------------------------------
REGISTRATION_ENABLED=true

# --- Monitoring engine (worker) ------------------------------------------------
SCHEDULER_POLL_INTERVAL_MS=5000
CHECK_CONCURRENCY=10
CHECK_RETENTION_DAYS=90

# --- Web app -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
