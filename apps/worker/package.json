{
  "name": "@openmonitor/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/__tests__/**\"",
    "test": "jest"
  },
  "dependencies": {
    "@openmonitor/database": "workspace:*",
    "@openmonitor/monitoring-engine": "workspace:*",
    "@openmonitor/notifications": "workspace:*",
    "@openmonitor/shared": "workspace:*",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
